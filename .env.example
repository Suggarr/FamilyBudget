# PostgreSQL container
POSTGRES_DB=FamilyBudgetDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5433

# FamilyBudget applications
ConnectionStrings__FamilyBudgetDbContext=Host=localhost;Port=5433;Database=FamilyBudgetDb;Username=postgres;Password=replace-with-a-strong-password
TELEGRAM_BOT_TOKEN=replace-with-a-new-bot-token

# Local Ollama receipt recognition
OLLAMA_BASE_URL=http://localhost:11434/
OLLAMA_MODEL=qwen3.5:4b
